<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EJS Practice</title>
</head>

<body>
  <%- include('partials/header') %>

  <h2>Hello, <%= person.name %></h2>
  <h3>Occupation, <%= person.occupation %></h3>

  <% if (['plumber', 'organist', 'bagpiper'].includes(person.occupation.toLowerCase())) { %>
    <p>You work with pipes!</p>
  <% } else { %>
    <p>That's an interesting job!</p>
  <% } %>

  <h4>Favorite color, <%= person.favcolor %></h4>

  <% if (['white', 'grey', 'black'].includes(person.favcolor.toLowerCase()))  { %>
    <p>You like essentials colors</p>
  <% } else { %>
    <p>You like colors of the rainbow</p>
  <% } %>
  
  <%- include('partials/footer') %>
</body>

</html>